{
	"name": "discord_bot",
	"version": "1.0.0",
	"type": "module",
	"main": "src/index.js",
	"scripts": {
		"build": "tsc --project tsconfig.build.json && tsc-alias -f -p tsconfig.build.json",
		"start": "pnpm run build && node dist/index.js",
		"test": "jest",
		"lint": "tsc --noEmit && biome check",
		"fix": "biome format --write"
	},
	"license": "Zlib",
	"private": true,
	"dependencies": {
		"@aws-sdk/client-s3": "*",
		"@discordjs/opus": "*",
		"@discordjs/voice": "*",
		"@iarna/toml": "*",
		"@msgpack/msgpack": "*",
		"@napi-rs/canvas": "*",
		"discord.js": "*",
		"fuse.js": "*",
		"lodash": "*",
		"music-metadata": "*",
		"pako": "*",
		"sodium-native": "*",
		"uuid": "*",
		"zod": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "*",
		"@types/jest": "*",
		"@types/lodash": "*",
		"@types/node": "*",
		"globals": "*",
		"jest": "*",
		"ts-jest": "*",
		"tsc-alias": "*",
		"typescript": "*"
	},
	"packageManager": "pnpm@12.15.0"
}
