{
	"name": "discord_bot",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"start": "pnpm run build && node dist/index.mjs",
		"test": "vitest run",
		"lint": "tsc --noEmit && biome check",
		"fix": "biome format --write"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"license": "Zlib",
	"private": true,
	"dependencies": {
		"@aws-sdk/client-s3": "*",
		"@discordjs/opus": "*",
		"@discordjs/voice": "*",
		"@iarna/toml": "*",
		"@msgpack/msgpack": "*",
		"@napi-rs/canvas": "*",
		"discord.js": "*",
		"fuse.js": "*",
		"lodash": "*",
		"music-metadata": "*",
		"pako": "*",
		"sodium-native": "*",
		"uuid": "*",
		"zod": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "*",
		"@types/lodash": "*",
		"@types/node": "*",
		"globals": "*",
		"tsc-alias": "*",
		"tsdown": "*",
		"typescript": "*",
		"vitest": "*"
	},
	"packageManager": "pnpm@12.15.0"
}
